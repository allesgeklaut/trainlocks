# Copy this file to `.env` and adjust to taste. `.env` is gitignored and is the
# only file you need to create for local (non-secret) LLM configuration.
#
# The LLM API key is NOT stored here or in any committed file: the app reads
# it from /opt/secrets/litellm.key (mounted read-only by docker-compose.yml).
#
# For the container, docker-compose.yml passes these through its env_file —
# NOT via `environment:` (a `environment:` entry would clobber env_file
# values). docker compose also auto-reads this repo-local .env for ${VAR:-…}
# interpolation. Keep LLM_BACKENDS on ONE line (env files are line-based).

# Master switch for the AI features (coach chat + screenshot-to-session).
# Set to false to turn them off.
LLM_ENABLED=true

# Multi-backend LLM config: JSON list of {"name","type","url","model"}.
#   type "ollama"  = Ollama native /api/chat (vision on cloud models)
#   type "openai"  = OpenAI-compatible /v1/chat/completions (LiteLLM, vLLM,
#                    llama.cpp llama-server, OpenAI itself, ...)
# A per-backend "api_key" may also be set; if omitted the shared key file
# (LITELLM_API_KEY_FILE) is used.
# Optional per-backend flag "enable_thinking": true sends
# chat_template_kwargs (thinking budget from LLM_REASONING_EFFORT).
LLM_BACKENDS=[{"name":"llama-server","type":"openai","url":"http://host.docker.internal:4000","model":"qwen3.8-27b"},{"name":"ollama","type":"ollama","url":"http://host.docker.internal:11434","model":"glm-5.3-flash:cloud"}]

# Per-request LLM read timeout in seconds (default 600).
# LLM_TIMEOUT_SECONDS=600

# Thinking budget for backends with "enable_thinking": true — one of
# low | medium | high | xhigh. Empty = backend default.
# LLM_REASONING_EFFORT=
